// Data and callbacks shared between Rust and the dashboard.

export struct TimerRow {
    id: int,
    name: string,
    total: string,       // "4 MIN"
    remaining: string,   // "3:59"
    progress: float,     // 0 → 1
    paused: bool,
    finished: bool,
}

export struct AlarmRow {
    id: int,
    time: string,        // "7:00"
    ampm: string,        // "AM"
    days: string,        // "WEEKDAYS"
    label: string,
    enabled: bool,
}

export struct ReminderRow {
    id: int,
    text: string,
    when: string,        // "TODAY 5:00 PM", "TOMORROW", ""
    tag: string,         // "LOCAL" for timed reminders
    done: bool,
}

export struct Marker {
    pos: float,          // fraction of the day
    kind: int,           // 0 alarm, 1 reminder, 2 timer, 3 calendar event
    label: string,       // alarms: "7:00 AM" caption above the bar
    later: bool,         // alarms: next fires tomorrow (its time today has passed)
}

export struct CalendarEventRow {
    title: string,
    when: string,
    position: float,
    timed: bool,
    birthday: bool,
}

export global Google {
    in property <[CalendarEventRow]> events;
    in property <string> tasks-status: "NOT CONNECTED";
    in property <string> calendar-status: "NOT CONNECTED";
    in property <string> new-mail: "NOT CONNECTED";
}

export global Dash {
    in property <[TimerRow]> timers;
    in property <[AlarmRow]> alarms;
    in property <[ReminderRow]> reminders;
    in property <[Marker]> markers;

    // Briefing column facts
    in property <string> next-alarm: "NONE";
    in property <string> open-reminders: "0";

    // Command bar
    in-out property <string> command;
    in property <string> result;
    in property <bool> result-builtin;
    in property <bool> can-undo;

    callback submit(string);
    callback undo();
    callback activity();
    callback timer-pause-toggle(int);
    callback timer-remove(int);
    callback alarm-toggle(int);
    callback alarm-remove(int);
    callback reminder-toggle(int);
    callback reminder-remove(int);
    callback play-briefing();

    // Assistant answer card (above the command bar)
    in property <bool> answer-visible;
    in property <bool> answer-busy;
    in property <string> answer-question;
    in property <string> answer-route;     // "LOCAL · LLAMA3.2:3B"
    in property <string> answer-text;
    in property <string> answer-actions;   // what it changed, e.g. "TIMER · PASTA · 5 MIN"
    in property <bool> answer-can-undo;
    callback answer-close();
    callback answer-undo();
}

// Timer takeover + alarm ringing overlays.
export enum AlarmPhase { ringing, snoozed, dismissed }

export global Ring {
    // Timer takeover
    in property <string> timer-name;
    in property <string> timer-count;   // "7"
    in property <int> timer-blocks;     // 0..10 blocks left
    in property <bool> timer-up;        // TIME'S UP

    // Alarm
    in property <AlarmPhase> alarm-phase;
    in property <string> alarm-label;       // "ALARM · GYM"
    in property <string> alarm-time;        // "7:00"
    in property <string> alarm-ampm;
    in property <float> alarm-volume;       // 0..1, ramps 20% → 100%
    in property <string> alarm-elapsed;     // "RINGING 0:42"
    in property <string> snooze-label;      // "SNOOZE · 9 MIN"
    in property <string> snooze-countdown;  // "8:59"
    in property <string> snooze-again;      // "RINGS AGAIN AT 7:09 AM"
    in property <string> greeting;          // "GOOD MORNING"
    in property <string> dismissed-note;    // date, or "STOPPED AFTER 10 MIN"

    // Flips once per second: TIME'S UP pulse, ringing background
    in property <bool> pulse;

    callback timer-add-minute();
    callback timer-stop();
    callback timer-restart();
    callback timer-dismiss();
    callback alarm-snooze();
    callback alarm-dismiss();
    callback alarm-close();
    callback play-briefing();
}

// Weather panel (Open-Meteo).
export struct HourCell { hour: string, temp: string, precip: string }
export struct DayCell { day: string, condition: string, lo: string, hi: string, start: float, end: float }

export global Weather {
    in property <bool> has-data;
    in property <string> message;   // shown when there's no data
    in property <string> place;
    in property <string> updated;
    in property <string> temp;
    in property <string> condition;
    in property <string> details;
    in property <string> hilo;
    in property <[HourCell]> hours;
    in property <[DayCell]> days;
}

// Assistant screen.
export struct ConvRow { id: int, title: string, when: string }

export struct ChatMsg {
    id: int,
    role: string,        // "user", "assistant", "notice"
    text: string,
    route: string,       // "LOCAL · LLAMA3.2:3B", "BUILT-IN · NO AI USED", …
    cloud: bool,
    actions: string,     // what it changed
    can-undo: bool,
    pending: bool,       // still streaming
    when: string,        // "9:41 AM"
}

export global Chat {
    in property <[ConvRow]> conversations;
    in property <int> current-id: -1;       // -1 = new, not saved yet
    in property <string> current-title: "New conversation";
    in property <bool> cloud;               // this conversation's mode
    in property <[ChatMsg]> messages;
    in property <bool> busy;
    in-out property <string> input;

    // Privacy panel
    in property <string> local-model;       // "LLAMA3.2:3B"
    in property <string> local-address;     // "127.0.0.1:11434"
    in property <string> local-status: "CHECKING…";
    in property <string> cloud-status: "NOT SET UP";

    callback new-conversation();
    callback select(int);
    callback delete(int);
    callback send(string);
    callback set-cloud(bool);
    callback undo();
    callback stop();
}
