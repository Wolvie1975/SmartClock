import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { IdleScreen } from "idle.slint";
import { Dashboard } from "dashboard.slint";
import { AssistantScreen } from "assistant.slint";
import { SettingsScreen } from "settings.slint";
import { TimerTakeover, AlarmTakeover } from "takeover.slint";
import { NewsItem } from "state.slint";

export { Theme }
export { Dash, TimerRow, AlarmRow, ReminderRow, Marker, Ring, AlarmPhase, Weather, HourCell, DayCell, Chat, ChatMsg, ConvRow, Google, CalendarEventRow, NewsItem } from "state.slint";

export enum Screen { idle, dashboard, assistant, settings }
export enum Overlay { none, timer, alarm }

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    min-width: Theme.touch;
    height: Theme.touch;
    HorizontalLayout {
        padding-left: 4 * Theme.u;
        padding-right: 4 * Theme.u;
        Label {
            text: root.text;
            vertical-alignment: center;
            color: root.active ? Theme.accent-text : (ta.has-hover ? Theme.text : Theme.muted);
        }
    }
    Rectangle {
        y: parent.height - 2 * Theme.u;
        height: 2 * Theme.u;
        background: root.active ? Theme.accent-fill : transparent;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "Smart Clock";
    preferred-width: 1920px;
    preferred-height: 1080px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    init => { Theme.u = min(self.width / 1920, self.height / 1080); }
    changed width => { Theme.u = min(self.width / 1920, self.height / 1080); }
    changed height => { Theme.u = min(self.width / 1920, self.height / 1080); }

    in-out property <Screen> screen: Screen.dashboard;
    in-out property <Overlay> overlay: Overlay.none;

    // Clock values pushed from Rust every tick
    in property <string> time-hm: "12:00";
    in property <string> time-ss: "00";
    in property <string> ampm: "AM";
    in-out property <string> clock-face: "digital";
    in property <string> hour-label: "12";
    in property <string> minute-label: "00";
    in property <string> hour-tens: "1";
    in property <string> hour-ones: "2";
    in property <string> minute-tens: "0";
    in property <string> minute-ones: "0";
    in property <string> previous-minute: "59";
    in property <string> next-minute: "01";
    in property <int> clock-hour: 12;
    in property <int> clock-minute: 0;
    in property <int> clock-second: 0;
    in property <string> date-label: "";
    in property <string> tz-label: "";
    in property <string> week-label: "";
    in property <string> info-strip: "";
    in property <float> day-progress: 0;

    // Idle screen burn-in drift + brightness
    in property <length> drift-x: 0;
    in property <length> drift-y: 0;
    in property <float> idle-brightness: 1.0;

    in property <string> ai-local-url: "http://127.0.0.1:11434";
    in property <string> ai-local-model: "llama3.2:3b";
    in property <string> ai-cloud-provider: "ANTHROPIC";
    in property <string> ai-cloud-model: "claude-opus-5-5";
    in property <string> ai-api-key: "";
    in property <string> ai-local-status: "READY";
    in property <string> ai-cloud-status: "NOT SET UP";
    in property <string> google-client-id: "";
    in property <string> google-status: "NOT CONNECTED";
    in property <string> google-calendar-status: "NOT CONNECTED";
    in property <bool> google-tasks: true;
    in property <bool> google-busy: false;
    in property <[NewsItem]> news-items;
    in property <string> news-footer: "LOADING · GOOGLE NEWS";
    in property <bool> news-offline: false;
    in-out property <string> settings-save-status: "";

    callback activity();          // any pointer movement → reset idle timer
    callback toggle-theme();
    callback clock-face-changed(string);
    callback quit();
    callback save-settings(string, string, string, string, string, string, bool);
    callback connect-google(string, bool);
    callback connect-calendar();
    callback disconnect-google();
    callback open-news(string);

    // CLOSE asks once before quitting, because alarms stop when the app closes.
    property <bool> confirm-close: false;

    // Pointer activity anywhere in the window.
    TouchArea {
        changed mouse-x => { root.activity(); }
        changed mouse-y => { root.activity(); }
        pointer-event(e) => { root.activity(); }

        if root.screen == Screen.idle: IdleScreen {
            time-hm: root.time-hm;
            time-ss: root.time-ss;
            ampm: root.ampm;
            clock-face: root.clock-face;
            hour-label: root.hour-label;
            minute-label: root.minute-label;
            hour-tens: root.hour-tens;
            hour-ones: root.hour-ones;
            minute-tens: root.minute-tens;
            minute-ones: root.minute-ones;
            previous-minute: root.previous-minute;
            next-minute: root.next-minute;
            hour: root.clock-hour;
            minute: root.clock-minute;
            second: root.clock-second;
            date-label: root.date-label;
            tz-label: root.tz-label;
            week-label: root.week-label;
            info-strip: root.info-strip;
            day-progress: root.day-progress;
            drift-x: root.drift-x;
            drift-y: root.drift-y;
            brightness: root.idle-brightness;
        }

        if root.screen != Screen.idle: VerticalLayout {
            // Header: tabs + theme toggle
            Rectangle {
                height: 64 * Theme.u;
                // Everything sits in one layout so each control only covers its own area.
                HorizontalLayout {
                    padding-left: Theme.page-pad;
                    padding-right: Theme.page-pad;
                    spacing: 32 * Theme.u;
                    Label { text: "SMART CLOCK"; color: Theme.text; vertical-alignment: center; }
                    Rectangle { width: 32 * Theme.u; }
                    Tab { text: "DASHBOARD"; active: root.screen == Screen.dashboard; clicked => { root.screen = Screen.dashboard; } }
                    Tab { text: "ASSISTANT"; active: root.screen == Screen.assistant; clicked => { root.screen = Screen.assistant; } }
                    Tab { text: "SETTINGS";  active: root.screen == Screen.settings;  clicked => { root.screen = Screen.settings; } }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Tab {
                            text: Theme.dark ? "LIGHT" : "DARK";
                            active: false;
                            clicked => { root.toggle-theme(); }
                        }
                    }
                    if !root.confirm-close: VerticalLayout {
                        alignment: center;
                        Tab {
                            text: "CLOSE";
                            active: false;
                            clicked => { root.confirm-close = true; }
                        }
                    }
                    if root.confirm-close: HorizontalLayout {
                        spacing: 20 * Theme.u;
                        Label {
                            text: "CLOSE THE CLOCK? ALARMS WON'T RING WHILE IT'S CLOSED";
                            color: Theme.accent-text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Tab {
                                text: "CLOSE";
                                active: true;
                                clicked => { root.quit(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Tab {
                                text: "CANCEL";
                                active: false;
                                clicked => { root.confirm-close = false; }
                            }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: Theme.hairline; background: Theme.line; }
            }

            if root.screen == Screen.dashboard: Dashboard {
                time-hm: root.time-hm;
                time-ss: root.time-ss;
                ampm: root.ampm;
                clock-face: root.clock-face;
                hour-label: root.hour-label;
                minute-label: root.minute-label;
                hour-tens: root.hour-tens;
                hour-ones: root.hour-ones;
                minute-tens: root.minute-tens;
                minute-ones: root.minute-ones;
                previous-minute: root.previous-minute;
                next-minute: root.next-minute;
                hour: root.clock-hour;
                minute: root.clock-minute;
                second: root.clock-second;
                date-label: root.date-label;
                day-progress: root.day-progress;
                news-items: root.news-items;
                news-footer: root.news-footer;
                news-offline: root.news-offline;
                open-news(url) => { root.open-news(url); }
            }
            if root.screen == Screen.assistant: AssistantScreen { }
            if root.screen == Screen.settings: SettingsScreen {
                vertical-stretch: 1;
                clock-face: root.clock-face;
                local-url: root.ai-local-url;
                local-model: root.ai-local-model;
                cloud-provider: root.ai-cloud-provider;
                cloud-model: root.ai-cloud-model;
                api-key: root.ai-api-key;
                local-status: root.ai-local-status;
                cloud-status: root.ai-cloud-status;
                google-client-id: root.google-client-id;
                google-status: root.google-status;
                google-calendar-status: root.google-calendar-status;
                google-tasks: root.google-tasks;
                google-busy: root.google-busy;
                save-status: root.settings-save-status;
                clock-face-changed(face) => {
                    root.clock-face = face;
                    root.clock-face-changed(face);
                }
                save(local_url, local_model, cloud_provider, cloud_model, api_key, google_client_id, google_tasks) => {
                    root.save-settings(local_url, local_model, cloud_provider, cloud_model, api_key, google_client_id, google_tasks);
                }
                connect_google(client_id, tasks) => {
                    root.connect-google(client_id, tasks);
                }
                connect_calendar => { root.connect-calendar(); }
                disconnect_google => { root.disconnect-google(); }
            }
        }
    }

    // Overlays cover everything, including the idle screen, and swallow input
    // so nothing underneath can be clicked.
    if root.overlay != Overlay.none: Rectangle {
        background: Theme.bg;
        TouchArea { }
        if root.overlay == Overlay.timer: TimerTakeover { }
        if root.overlay == Overlay.alarm: AlarmTakeover { }
    }
}
