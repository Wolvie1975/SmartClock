import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { TextButton, Check } from "widgets/controls.slint";
import { ClockDisplay } from "widgets/clock-faces.slint";
import { Slider } from "std-widgets.slint";

component ClockFaceOption inherits Rectangle {
    in property <string> face;
    in property <string> title;
    in property <bool> selected;
    callback choose(string);

    horizontal-stretch: 1;
    height: 144 * Theme.u;
    border-radius: Theme.radius;
    border-width: selected ? 2 * Theme.u : Theme.hairline;
    border-color: selected ? Theme.accent-fill : Theme.line;
    background: selected ? Theme.panel : transparent;

    VerticalLayout {
        padding: 8 * Theme.u;
        spacing: 6 * Theme.u;
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                ClockDisplay {
                    face: root.face;
                    time-hm: "12:34";
                    time-ss: "56";
                    ampm: "PM";
                    hour-label: "12";
                    minute-label: "34";
                    hour-tens: "1";
                    hour-ones: "2";
                    minute-tens: "3";
                    minute-ones: "4";
                    previous-minute: "33";
                    next-minute: "35";
                    hour: 12;
                    minute: 34;
                    second: 56;
                    size: 36 * Theme.u;
                }
            }
        }
        Label {
            text: root.title;
            color: root.selected ? Theme.accent-text : Theme.text;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.choose(root.face); }
    }
}

export component SettingsScreen inherits Rectangle {
    in-out property <string> local-url: "http://127.0.0.1:11434";
    in-out property <string> local-model: "llama3.2:3b";
    in-out property <string> cloud-provider: "ANTHROPIC";
    in-out property <string> cloud-model: "claude-opus-5-5";
    in-out property <string> api-key: "";
    in-out property <string> local-status: "READY";
    in-out property <string> cloud-status: "NOT SET UP";
    in-out property <string> google-client-id: "";
    in-out property <string> google-status: "NOT CONNECTED";
    in-out property <string> google-calendar-status: "NOT CONNECTED";
    in-out property <bool> google-tasks: true;
    in-out property <bool> google-busy: false;
    in-out property <string> clock-face: "digital";
    in-out property <bool> night-enabled: true;
    in-out property <string> night-start: "10:00 PM";
    in-out property <string> night-end: "6:00 AM";
    in-out property <float> night-dim: 0.65;
    in-out property <string> save-status: "";

    callback save(string, string, string, string, string, string, bool, bool, string, string, float);
    callback clock-face-changed(string);
    callback connect-google(string, bool);
    callback connect-calendar();
    callback disconnect-google();

    layout := VerticalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 20 * Theme.u;
        padding-bottom: 20 * Theme.u;
        spacing: 16 * Theme.u;

        Label {
            text: "SETTINGS";
            color: Theme.text;
            font-size: 24 * Theme.u;
            font-weight: 600;
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            border-radius: 8 * Theme.u;

            VerticalLayout {
                padding-left: 20 * Theme.u;
                padding-right: 20 * Theme.u;
                padding-top: 16 * Theme.u;
                padding-bottom: 16 * Theme.u;
                spacing: 12 * Theme.u;
                Label {
                    text: "APPEARANCE · CLOCK FACE · APPLIES TO DASHBOARD AND IDLE";
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 10 * Theme.u;
                    ClockFaceOption {
                        face: "digital";
                        title: "DIGITAL";
                        selected: root.clock-face == self.face;
                        choose(value) => {
                            root.clock-face = value;
                            root.clock-face-changed(value);
                        }
                    }
                    ClockFaceOption {
                        face: "chronograph";
                        title: "CHRONOGRAPH";
                        selected: root.clock-face == self.face;
                        choose(value) => {
                            root.clock-face = value;
                            root.clock-face-changed(value);
                        }
                    }
                    ClockFaceOption {
                        face: "split-flap";
                        title: "SPLIT-FLAP";
                        selected: root.clock-face == self.face;
                        choose(value) => {
                            root.clock-face = value;
                            root.clock-face-changed(value);
                        }
                    }
                    ClockFaceOption {
                        face: "tape";
                        title: "TAPE";
                        selected: root.clock-face == self.face;
                        choose(value) => {
                            root.clock-face = value;
                            root.clock-face-changed(value);
                        }
                    }
                }
            }
        }

        fl := Flickable {
            width: parent.width;
            vertical-stretch: 1;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: fl.width;
                spacing: 20 * Theme.u;

        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            border-radius: 8 * Theme.u;

            VerticalLayout {
                padding-left: 20 * Theme.u;
                padding-right: 20 * Theme.u;
                padding-top: 20 * Theme.u;
                padding-bottom: 20 * Theme.u;
                spacing: 12 * Theme.u;
                Label { text: "NIGHT DIMMING"; color: Theme.muted; }
                HorizontalLayout {
                    spacing: 8 * Theme.u;
                    Check {
                        checked: root.night-enabled;
                        toggled => {
                            root.night-enabled = !root.night-enabled;
                            root.save-status = "UNSAVED CHANGES";
                        }
                    }
                    Label {
                        text: "DIM SCREENSAVER DURING NIGHT HOURS";
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label { width: 130 * Theme.u; text: "FROM"; color: Theme.muted; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            enabled: root.night-enabled;
                            text: root.night-start;
                            edited => {
                                root.night-start = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                    Label { text: "TO"; color: Theme.muted; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            enabled: root.night-enabled;
                            text: root.night-end;
                            edited => {
                                root.night-end = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label { width: 130 * Theme.u; text: "DIM LEVEL"; color: Theme.muted; vertical-alignment: center; }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 0.9;
                        value <=> root.night-dim;
                        enabled: root.night-enabled;
                        changed value => { root.save-status = "UNSAVED CHANGES"; }
                    }
                    Label { text: "0–90%"; color: Theme.muted; vertical-alignment: center; }
                }
                Label {
                    text: "Times use the 12-hour format, for example 10:00 PM.";
                    color: Theme.muted;
                }
            }
        }

        Label {
            text: "AI & MODELS";
            color: Theme.text;
            font-size: 24 * Theme.u;
            font-weight: 600;
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            border-radius: 8 * Theme.u;

            VerticalLayout {
                padding-left: 20 * Theme.u;
                padding-right: 20 * Theme.u;
                padding-top: 20 * Theme.u;
                padding-bottom: 20 * Theme.u;
                spacing: 16 * Theme.u;
                Label {
                    text: "LOCAL MODEL";
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "URL";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            text: root.local-url;
                            edited => {
                                root.local-url = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "MODEL";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            text: root.local-model;
                            edited => {
                                root.local-model = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "STATUS";
                        color: Theme.muted;
                    }
                    Label {
                        text: root.local-status;
                        color: Theme.accent-text;
                    }
                }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            border-radius: 8 * Theme.u;

            VerticalLayout {
                padding-left: 20 * Theme.u;
                padding-right: 20 * Theme.u;
                padding-top: 20 * Theme.u;
                padding-bottom: 20 * Theme.u;
                spacing: 16 * Theme.u;
                Label {
                    text: "CLOUD MODEL";
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "PROVIDER";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            text: root.cloud-provider;
                            edited => {
                                root.cloud-provider = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                    }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "MODEL";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            text: root.cloud-model;
                            edited => {
                                root.cloud-model = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "API KEY";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            input-type: password;
                            text: root.api-key;
                            edited => {
                                root.api-key = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                        }
                        }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "STATUS";
                        color: Theme.muted;
                    }
                    Label {
                        text: root.cloud-status;
                        color: Theme.accent-text;
                    }
                }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            border-radius: 8 * Theme.u;

            VerticalLayout {
                padding-left: 20 * Theme.u;
                padding-right: 20 * Theme.u;
                padding-top: 20 * Theme.u;
                padding-bottom: 20 * Theme.u;
                spacing: 16 * Theme.u;
                Label {
                    text: "GOOGLE ACCOUNTS";
                    color: Theme.muted;
                }
                Label {
                    text: "Calendar connects through GNOME Online Accounts. Tasks needs a separate OAuth Desktop app client ID.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Label {
                    text: "Create it in Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Desktop app. Enable the Tasks API and add your account as a test user.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12 * Theme.u;
                    Label {
                        width: 130 * Theme.u;
                        text: "GOOGLE CLIENT ID";
                        color: Theme.muted;
                    }
                    Rectangle {
                        min-height: 36 * Theme.u;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: 4 * Theme.u;
                        TextInput {
                            x: 8 * Theme.u;
                            width: parent.width - 16 * Theme.u;
                            vertical-alignment: center;
                            text: root.google-client-id;
                            edited => {
                                root.google-client-id = self.text;
                                root.save-status = "UNSAVED CHANGES";
                            }
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8 * Theme.u;
                    Check {
                        checked: root.google-tasks;
                        toggled => {
                            root.google-tasks = !root.google-tasks;
                            root.save-status = "UNSAVED CHANGES";
                        }
                    }
                    Label { text: "SYNC UNTIMED REMINDERS WITH TASKS"; color: Theme.text; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 16 * Theme.u;
                    Label {
                        text: "TASKS · " + root.google-status;
                        color: Theme.accent-text;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TextButton {
                        text: root.google-busy ? "CONNECTING…" : "CONNECT TASKS";
                        primary: true;
                        enabled: !root.google-busy && root.google-tasks;
                        clicked => {
                            root.connect-google(root.google-client-id, root.google-tasks);
                        }
                    }
                    TextButton {
                        text: "DISCONNECT";
                        enabled: !root.google-busy;
                        clicked => { root.disconnect-google(); }
                    }
                }
                HorizontalLayout {
                    spacing: 16 * Theme.u;
                    Label {
                        text: "CALENDAR · " + root.google-calendar-status;
                        color: Theme.accent-text;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TextButton {
                        text: "CHECK GNOME ONLINE ACCOUNTS";
                        enabled: !root.google-busy;
                        clicked => { root.connect-calendar(); }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 12 * Theme.u;
            Label {
                text: root.save-status;
                color: root.save-status == "SAVE FAILED" ? Theme.muted : Theme.accent-text;
                vertical-alignment: center;
            }
            Rectangle {
                width: 170 * Theme.u;
                height: 40 * Theme.u;
                background: Theme.accent-fill;
                border-radius: 8 * Theme.u;
                Label {
                    text: "SAVE SETTINGS";
                    color: Theme.on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea {
                    clicked => {
                        root.save(
                            root.local-url,
                            root.local-model,
                            root.cloud-provider,
                            root.cloud-model,
                            root.api-key,
                            root.google-client-id,
                            root.google-tasks,
                            root.night-enabled,
                            root.night-start,
                            root.night-end,
                            root.night-dim
                        );
                    }
                }
            }
        }
    }
}
}
}
