import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { ClockDisplay } from "widgets/clock-faces.slint";
import { DayTimeline } from "widgets/timeline.slint";
import { TextButton, Toggle, Check } from "widgets/controls.slint";
import { Dash, TimerRow, AlarmRow, ReminderRow, NewsItem } from "state.slint";
import { WeatherPanel } from "weather.slint";
import { NewsColumn } from "widgets/news-column.slint";

// ---------------------------------------------------------------------------
// Columns

component Column inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <bool> addable: true;
    callback add();

    VerticalLayout {
        padding-left: 24 * Theme.u;
        padding-right: 24 * Theme.u;
        spacing: 0;

        HorizontalLayout {
            height: Theme.touch;
            spacing: 12 * Theme.u;
            Label { text: root.title; color: Theme.text; vertical-alignment: center; }
            Label { text: root.count; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.addable: TextButton {
                text: "+";
                clicked => { root.add(); }
            }
        }
        Rectangle { height: 12 * Theme.u; }
        Rectangle { height: Theme.hairline; background: Theme.line; }
        @children
    }
}

component Empty inherits Label {
    height: 56 * Theme.u;
    vertical-alignment: center;
}

component RowLine inherits Rectangle {
    height: Theme.hairline;
    background: Theme.line;
}

component Centered inherits VerticalLayout {
    alignment: center;
}

// ---------------------------------------------------------------------------
// Rows

component TimerItem inherits Rectangle {
    in property <TimerRow> item;
    height: 72 * Theme.u;

    HorizontalLayout {
        spacing: 8 * Theme.u;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6 * Theme.u;
            Text {
                text: item.name;
                font-family: Theme.sans;
                font-size: 18 * Theme.u;
                color: Theme.text;
                overflow: elide;
            }
            Label { text: item.paused ? "PAUSED · " + item.total : item.total; }
        }
        Text {
            text: item.remaining;
            min-width: 112 * Theme.u;
            font-family: Theme.mono;
            font-size: 34 * Theme.u;
            font-weight: 300;
            color: item.paused ? Theme.muted : Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Centered {
            TextButton {
                text: item.paused ? "▶" : "❚❚";
                clicked => { Dash.timer-pause-toggle(item.id); }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.timer-remove(item.id); }
            }
        }
    }
    // progress
    Rectangle {
        x: 0;
        y: parent.height - 3 * Theme.u;
        height: 2 * Theme.u;
        width: parent.width * item.progress;
        background: Theme.accent-fill;
    }
    RowLine { y: root.height - 1px; }
}

component AlarmItem inherits Rectangle {
    in property <AlarmRow> item;
    height: 72 * Theme.u;
    property <color> fg: item.enabled ? Theme.text : Theme.muted;

    HorizontalLayout {
        spacing: 10 * Theme.u;
        HorizontalLayout {
            spacing: 6 * Theme.u;
            alignment: start;
            Text {
                text: item.time;
                font-family: Theme.mono;
                font-size: 34 * Theme.u;
                font-weight: 300;
                color: root.fg;
                vertical-alignment: center;
            }
            Label { text: item.ampm; color: root.fg; vertical-alignment: center; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6 * Theme.u;
            Label { text: item.days; }
            if item.label != "": Text {
                text: item.label;
                font-size: 15 * Theme.u;
                color: root.fg;
                overflow: elide;
            }
        }
        Centered {
            Toggle {
                checked: item.enabled;
                toggled => { Dash.alarm-toggle(item.id); }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.alarm-remove(item.id); }
            }
        }
    }
    RowLine { y: root.height - 1px; }
}

component ReminderItem inherits Rectangle {
    in property <ReminderRow> item;
    height: 64 * Theme.u;

    HorizontalLayout {
        spacing: 6 * Theme.u;
        Centered {
            Check {
                checked: item.done;
                toggled => { Dash.reminder-toggle(item.id); }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6 * Theme.u;
            Text {
                text: item.text;
                font-size: 17 * Theme.u;
                color: item.done ? Theme.muted : Theme.text;
                overflow: elide;
            }
            if item.when != "" || item.tag != "": HorizontalLayout {
                spacing: 10 * Theme.u;
                alignment: start;
                Label { text: item.when; }
                if item.tag != "": Label { text: item.tag; color: Theme.accent-text; }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.reminder-remove(item.id); }
            }
        }
    }
    RowLine { y: root.height - 1px; }
}

// ---------------------------------------------------------------------------
// Assistant answer card

// Floats over the dashboard just above the command bar. Grows with the reply up
// to `max-body`, then the reply scrolls inside the card.
component AnswerCard inherits Rectangle {
    in property <length> max-body: 480 * Theme.u;

    background: Theme.panel;
    border-width: Theme.hairline;
    border-color: Theme.line;
    border-radius: Theme.radius;
    drop-shadow-blur: 32 * Theme.u;
    drop-shadow-offset-y: 8 * Theme.u;
    drop-shadow-color: Theme.dark ? #000000b0 : #00000040;
    height: layout.preferred-height;

    // Swallow clicks so nothing underneath the card reacts.
    TouchArea { }

    layout := VerticalLayout {
        padding: 20 * Theme.u;
        padding-top: 10 * Theme.u;
        spacing: 12 * Theme.u;

        HorizontalLayout {
            spacing: 16 * Theme.u;
            Label { text: Dash.answer-route; color: Theme.accent-text; vertical-alignment: center; }
            Label {
                text: Dash.answer-question;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if Dash.answer-busy: Label { text: "THINKING…"; vertical-alignment: center; }
            if Dash.answer-can-undo: Centered {
                TextButton {
                    text: "UNDO";
                    clicked => { Dash.answer-undo(); }
                }
            }
            Centered {
                TextButton {
                    text: "×";
                    clicked => { Dash.answer-close(); }
                }
            }
        }
        Rectangle { height: Theme.hairline; background: Theme.line; }

        fl := Flickable {
            height: min(body.preferred-height, root.max-body);
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: fl.width;
                spacing: 12 * Theme.u;
                if Dash.answer-actions != "": Label {
                    text: Dash.answer-actions;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if Dash.answer-text != "": Text {
                    text: Dash.answer-text;
                    font-family: Theme.sans;
                    font-size: 20 * Theme.u;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if Dash.answer-text == "" && Dash.answer-actions == "": Label { text: "…"; }
            }
        }
        // Scroll hint when the reply is longer than the card.
        if body.preferred-height > root.max-body: Label {
            text: fl.content-y < -(body.preferred-height - root.max-body - 4 * Theme.u) ? "END" : "SCROLL FOR MORE ↓";
            horizontal-alignment: right;
        }
    }
}

// ---------------------------------------------------------------------------
// Command bar

component CommandBar inherits Rectangle {
    height: 60 * Theme.u;
    background: Theme.panel;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.accent-fill : Theme.line;
    border-radius: Theme.radius;

    public function focus-input() {
        input.focus();
        input.set-selection-offsets(999, 999);
    }

    HorizontalLayout {
        padding-left: 20 * Theme.u;
        padding-right: 8 * Theme.u;
        spacing: 16 * Theme.u;

        Text {
            text: "›";
            font-family: Theme.mono;
            font-size: 22 * Theme.u;
            color: Theme.accent-text;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> Dash.command;
                font-family: Theme.mono;
                font-size: 18 * Theme.u;
                color: Theme.text;
                selection-background-color: Theme.accent-fill;
                selection-foreground-color: Theme.on-accent;
                vertical-alignment: center;
                single-line: true;
                accepted => { Dash.submit(self.text); }
                edited => { Dash.activity(); }
            }
            Text {
                visible: input.text == "";
                x: 0;
                height: parent.height;
                text: "TIMER 20M · ALARM 7AM WEEKDAYS · OR ASK ANYTHING";
                font-family: Theme.mono;
                font-size: 16 * Theme.u;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        if Dash.result != "": HorizontalLayout {
            spacing: 14 * Theme.u;
            if Dash.result-builtin: Label {
                text: "BUILT-IN · NO AI USED";
                color: Theme.accent-text;
                vertical-alignment: center;
            }
            Label { text: Dash.result; color: Theme.text; vertical-alignment: center; }
            if Dash.can-undo: Centered {
                TextButton {
                    text: "UNDO";
                    clicked => { Dash.undo(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

export component Dashboard inherits Rectangle {
    in property <string> time-hm;
    in property <string> time-ss;
    in property <string> ampm;
    in property <string> clock-face;
    in property <string> hour-label;
    in property <string> minute-label;
    in property <string> hour-tens;
    in property <string> hour-ones;
    in property <string> minute-tens;
    in property <string> minute-ones;
    in property <string> previous-minute;
    in property <string> next-minute;
    in property <int> hour;
    in property <int> minute;
    in property <int> second;
    in property <string> date-label;
    in property <float> day-progress;
    in property <[NewsItem]> news-items;
    in property <string> news-footer;
    in property <bool> news-offline;
    callback open-news(string);

    background: Theme.bg;

    function prefill(text: string) {
        Dash.command = text;
        bar.focus-input();
    }

    property <length> side-pad: Theme.page-pad;
    property <length> weather-width: 640 * Theme.u;
    property <length> clock-room:
        (root.width - 2 * root.side-pad) / 2;
    property <length> dashboard-clock-size:
        // ClockDisplay's layout width is 3.5 times its size.
        min(Theme.clock-dashboard, max(0px, root.clock-room / 3.5));

    VerticalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 20 * Theme.u;
        padding-bottom: 32 * Theme.u;
        spacing: 20 * Theme.u;

        top-row := Rectangle {
            width: parent.width;
            height: 560 * Theme.u;

            weather := WeatherPanel {
                width: root.weather-width;
                height: parent.height - 48 * Theme.u;
                x: parent.width / 2 + (parent.width / 2 - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clip: true;
            }

            clock-group := VerticalLayout {
                width: self.preferred-width;
                height: self.preferred-height;
                x: (parent.width / 2 - self.width) / 2;
                y: (parent.height - self.height) / 2;
                spacing: 16 * Theme.u;
                Label {
                    horizontal-stretch: 1;
                    text: root.date-label;
                    font-size: 15 * Theme.u;
                    letter-spacing: 1.8 * Theme.u;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    ClockDisplay {
                        face: root.clock-face;
                        time-hm: root.time-hm;
                        time-ss: root.time-ss;
                        ampm: root.ampm;
                        hour-label: root.hour-label;
                        minute-label: root.minute-label;
                        hour-tens: root.hour-tens;
                        hour-ones: root.hour-ones;
                        minute-tens: root.minute-tens;
                        minute-ones: root.minute-ones;
                        previous-minute: root.previous-minute;
                        next-minute: root.next-minute;
                        hour: root.hour;
                        minute: root.minute;
                        second: root.second;
                        size: root.dashboard-clock-size;
                    }
                }
            }
        }

        DayTimeline {
            progress: root.day-progress;
            markers: Dash.markers;
        }

        // Timers · Alarms · Reminders · News
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            Column {
                horizontal-stretch: 1;
                title: "TIMERS";
                count: Dash.timers.length;
                add => { root.prefill("timer "); }
                tl := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: tl.width;
                        alignment: start;
                        for t in Dash.timers: TimerItem { item: t; }
                        if Dash.timers.length == 0: Empty { text: "NONE · TRY “TEA TIMER 4M”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            Column {
                horizontal-stretch: 1;
                title: "ALARMS";
                count: Dash.alarms.length;
                add => { root.prefill("alarm "); }
                al := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: al.width;
                        alignment: start;
                        for a in Dash.alarms: AlarmItem { item: a; }
                        if Dash.alarms.length == 0: Empty { text: "NONE · TRY “ALARM 7AM WEEKDAYS”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            Column {
                horizontal-stretch: 1;
                title: "REMINDERS";
                count: Dash.open-reminders;
                add => { root.prefill("remind me to "); }
                rl := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: rl.width;
                        alignment: start;
                        for r in Dash.reminders: ReminderItem { item: r; }
                        if Dash.reminders.length == 0: Empty { text: "NONE · TRY “REMIND ME TO …”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            NewsColumn {
                horizontal-stretch: 1;
                items: root.news-items;
                footer: root.news-footer;
                offline: root.news-offline;
                open-story(url) => { root.open-news(url); }
            }
        }

        bar := CommandBar { }
    }

    // Assistant reply: a pop-over above the command bar, not part of the layout.
    if Dash.answer-visible: AnswerCard {
        x: Theme.page-pad;
        width: root.width - 2 * Theme.page-pad;
        max-body: root.height * 0.6;
        y: bar.y - self.height - 12 * Theme.u;
    }
}
