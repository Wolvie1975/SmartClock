import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { DayTimeline } from "widgets/timeline.slint";
import { TextButton, Toggle, Check } from "widgets/controls.slint";
import { Dash, TimerRow, AlarmRow, ReminderRow } from "state.slint";
import { WeatherPanel } from "weather.slint";

// ---------------------------------------------------------------------------
// Columns

component Column inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <bool> addable: true;
    callback add();

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 0;

        HorizontalLayout {
            height: Theme.touch;
            spacing: 12px;
            Label { text: root.title; color: Theme.text; vertical-alignment: center; }
            Label { text: root.count; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.addable: TextButton {
                text: "+";
                clicked => { root.add(); }
            }
        }
        Rectangle { height: 12px; }
        Rectangle { height: Theme.hairline; background: Theme.line; }
        @children
    }
}

component Empty inherits Label {
    height: 56px;
    vertical-alignment: center;
}

component RowLine inherits Rectangle {
    height: Theme.hairline;
    background: Theme.line;
}

component Centered inherits VerticalLayout {
    alignment: center;
}

// ---------------------------------------------------------------------------
// Rows

component TimerItem inherits Rectangle {
    in property <TimerRow> item;
    height: 72px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: item.name;
                font-family: Theme.sans;
                font-size: 18px;
                color: Theme.text;
                overflow: elide;
            }
            Label { text: item.paused ? "PAUSED · " + item.total : item.total; }
        }
        Text {
            text: item.remaining;
            min-width: 112px;
            font-family: Theme.mono;
            font-size: 34px;
            font-weight: 300;
            color: item.paused ? Theme.muted : Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Centered {
            TextButton {
                text: item.paused ? "▶" : "❚❚";
                clicked => { Dash.timer-pause-toggle(item.id); }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.timer-remove(item.id); }
            }
        }
    }
    // progress
    Rectangle {
        x: 0;
        y: parent.height - 3px;
        height: 2px;
        width: parent.width * item.progress;
        background: Theme.accent-fill;
    }
    RowLine { y: root.height - 1px; }
}

component AlarmItem inherits Rectangle {
    in property <AlarmRow> item;
    height: 72px;
    property <color> fg: item.enabled ? Theme.text : Theme.muted;

    HorizontalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: item.time;
                font-family: Theme.mono;
                font-size: 34px;
                font-weight: 300;
                color: root.fg;
                vertical-alignment: center;
            }
            Label { text: item.ampm; color: root.fg; vertical-alignment: center; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Label { text: item.days; }
            if item.label != "": Text {
                text: item.label;
                font-size: 15px;
                color: root.fg;
                overflow: elide;
            }
        }
        Centered {
            Toggle {
                checked: item.enabled;
                toggled => { Dash.alarm-toggle(item.id); }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.alarm-remove(item.id); }
            }
        }
    }
    RowLine { y: root.height - 1px; }
}

component ReminderItem inherits Rectangle {
    in property <ReminderRow> item;
    height: 64px;

    HorizontalLayout {
        spacing: 6px;
        Centered {
            Check {
                checked: item.done;
                toggled => { Dash.reminder-toggle(item.id); }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: item.text;
                font-size: 17px;
                color: item.done ? Theme.muted : Theme.text;
                overflow: elide;
            }
            if item.when != "" || item.tag != "": HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Label { text: item.when; }
                if item.tag != "": Label { text: item.tag; color: Theme.accent-text; }
            }
        }
        Centered {
            TextButton {
                text: "×";
                clicked => { Dash.reminder-remove(item.id); }
            }
        }
    }
    RowLine { y: root.height - 1px; }
}

component Fact inherits Rectangle {
    in property <string> key;
    in property <string> value;
    in property <bool> pending: false;
    height: 56px;
    HorizontalLayout {
        Label { text: root.key; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Label {
            text: root.value;
            color: root.pending ? Theme.muted : Theme.text;
            vertical-alignment: center;
        }
    }
    RowLine { y: root.height - 1px; }
}

// ---------------------------------------------------------------------------
// Command bar

component CommandBar inherits Rectangle {
    height: 60px;
    background: Theme.panel;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.accent-fill : Theme.line;
    border-radius: Theme.radius;

    public function focus-input() {
        input.focus();
        input.set-selection-offsets(999, 999);
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 8px;
        spacing: 16px;

        Text {
            text: "›";
            font-family: Theme.mono;
            font-size: 22px;
            color: Theme.accent-text;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> Dash.command;
                font-family: Theme.mono;
                font-size: 18px;
                color: Theme.text;
                selection-background-color: Theme.accent-fill;
                selection-foreground-color: Theme.on-accent;
                vertical-alignment: center;
                single-line: true;
                accepted => { Dash.submit(self.text); }
                edited => { Dash.activity(); }
            }
            Text {
                visible: input.text == "";
                x: 0;
                height: parent.height;
                text: "TIMER 20M · ALARM 7AM WEEKDAYS · REMIND ME AT 5 TO CHECK THE MAIL";
                font-family: Theme.mono;
                font-size: 16px;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        if Dash.result != "": HorizontalLayout {
            spacing: 14px;
            if Dash.result-builtin: Label {
                text: "BUILT-IN · NO AI USED";
                color: Theme.accent-text;
                vertical-alignment: center;
            }
            Label { text: Dash.result; color: Theme.text; vertical-alignment: center; }
            if Dash.can-undo: Centered {
                TextButton {
                    text: "UNDO";
                    clicked => { Dash.undo(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

export component Dashboard inherits Rectangle {
    in property <string> time-hm;
    in property <string> time-ss;
    in property <string> ampm;
    in property <string> date-label;
    in property <float> day-progress;

    background: Theme.bg;

    function prefill(text: string) {
        Dash.command = text;
        bar.focus-input();
    }

    VerticalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 20px;
        padding-bottom: 32px;
        spacing: 20px;

        // Clock + weather
        HorizontalLayout {
            spacing: 48px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                Label { text: root.date-label; color: Theme.text; }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: root.time-hm;
                        font-family: Theme.mono;
                        font-size: Theme.clock-dashboard;
                        font-weight: 300;
                        color: Theme.text;
                    }
                    Centered {
                        spacing: 12px;
                        Text { text: root.ampm; font-family: Theme.mono; font-size: 40px; color: Theme.accent-text; }
                        Text { text: root.time-ss; font-family: Theme.mono; font-size: 40px; font-weight: 300; color: Theme.muted; }
                    }
                }
            }
            WeatherPanel { width: 640px; }
        }

        DayTimeline {
            progress: root.day-progress;
            markers: Dash.markers;
        }

        // Timers · Alarms · Reminders · Briefing
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            Column {
                horizontal-stretch: 1;
                title: "TIMERS";
                count: Dash.timers.length;
                add => { root.prefill("timer "); }
                tl := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: tl.width;
                        alignment: start;
                        for t in Dash.timers: TimerItem { item: t; }
                        if Dash.timers.length == 0: Empty { text: "NONE · TRY “TEA TIMER 4M”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            Column {
                horizontal-stretch: 1;
                title: "ALARMS";
                count: Dash.alarms.length;
                add => { root.prefill("alarm "); }
                al := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: al.width;
                        alignment: start;
                        for a in Dash.alarms: AlarmItem { item: a; }
                        if Dash.alarms.length == 0: Empty { text: "NONE · TRY “ALARM 7AM WEEKDAYS”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            Column {
                horizontal-stretch: 1;
                title: "REMINDERS";
                count: Dash.open-reminders;
                add => { root.prefill("remind me to "); }
                rl := Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: rl.width;
                        alignment: start;
                        for r in Dash.reminders: ReminderItem { item: r; }
                        if Dash.reminders.length == 0: Empty { text: "NONE · TRY “REMIND ME TO …”"; }
                    }
                }
            }
            Rectangle { width: Theme.hairline; background: Theme.line; }
            Column {
                horizontal-stretch: 1;
                title: "BRIEFING";
                count: "MANUAL";
                addable: false;
                VerticalLayout {
                    vertical-stretch: 1;
                    Fact { key: "NEXT ALARM"; value: Dash.next-alarm; }
                    Fact { key: "OPEN REMINDERS"; value: Dash.open-reminders; }
                    Fact { key: "CALENDAR TODAY"; value: "PHASE 5"; pending: true; }
                    Fact { key: "NEW MAIL"; value: "PHASE 5"; pending: true; }
                    Rectangle { vertical-stretch: 1; min-height: 16px; }
                    TextButton {
                        text: "PLAY BRIEFING";
                        primary: true;
                        clicked => { Dash.play-briefing(); }
                    }
                }
            }
        }

        bar := CommandBar { }
    }
}
