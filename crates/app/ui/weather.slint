import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { Weather } from "state.slint";

// Now · next 8 hours · today and tomorrow.
export component WeatherPanel inherits Rectangle {
    border-width: Theme.hairline;
    border-color: Theme.line;
    border-radius: Theme.radius;

    if !Weather.has-data: VerticalLayout {
        alignment: center;
        padding: 24 * Theme.u;
        spacing: 12 * Theme.u;
        Label {
            text: Weather.place == "" ? "WEATHER" : "WEATHER · " + Weather.place;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Label { text: Weather.message; horizontal-alignment: center; overflow: elide; }
    }

    if Weather.has-data: VerticalLayout {
        padding: 24 * Theme.u;
        spacing: 12 * Theme.u;

        HorizontalLayout {
            Label {
                horizontal-stretch: 1;
                text: "WEATHER · " + Weather.place;
                color: Theme.text;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Label { text: Weather.updated; overflow: elide; }
        }

        // Now
        HorizontalLayout {
            spacing: 20 * Theme.u;
            Text {
                text: Weather.temp;
                font-family: Theme.mono;
                font-size: 84 * Theme.u;
                font-weight: 300;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 8 * Theme.u;
                Text {
                    text: Weather.condition;
                    font-family: Theme.mono;
                    font-size: 18 * Theme.u;
                    color: Theme.accent-text;
                    letter-spacing: 1.5 * Theme.u;
                    overflow: elide;
                }
                Label { text: Weather.details; overflow: elide; }
                Label { text: Weather.hilo; color: Theme.text; }
            }
        }

        // Next 8 hours
        Rectangle { height: Theme.hairline; background: Theme.line; }
        HorizontalLayout {
            for h in Weather.hours: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4 * Theme.u;
                Label { text: h.hour; horizontal-alignment: center; overflow: elide; }
                Text { text: h.temp; font-family: Theme.mono; font-size: 18 * Theme.u; color: Theme.text; horizontal-alignment: center; overflow: elide; }
                Label { text: h.precip == "" ? " " : h.precip; color: Theme.accent-text; horizontal-alignment: center; overflow: elide; }
            }
        }

        // Today and tomorrow
        Rectangle { height: Theme.hairline; background: Theme.line; }
        VerticalLayout {
            spacing: 2 * Theme.u;
            for d in Weather.days: HorizontalLayout {
                height: 22 * Theme.u;
                spacing: 12 * Theme.u;
                Label { text: d.day; width: 64 * Theme.u; vertical-alignment: center; color: Theme.text; overflow: elide; }
                Label { text: d.condition; width: 120 * Theme.u; vertical-alignment: center; overflow: elide; }
                Label { text: d.lo; width: 40 * Theme.u; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 2 * Theme.u;
                        background: Theme.line;
                    }
                    Rectangle {
                        x: parent.width * d.start;
                        width: max(6 * Theme.u, parent.width * (d.end - d.start));
                        y: (parent.height - self.height) / 2;
                        height: 6 * Theme.u;
                        border-radius: 3 * Theme.u;
                        background: Theme.accent-fill;
                    }
                }
                Label { text: d.hi; width: 40 * Theme.u; vertical-alignment: center; color: Theme.text; }
            }
        }
    }
}
