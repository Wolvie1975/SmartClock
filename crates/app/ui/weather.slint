import { Theme } from "theme.slint";
import { Label } from "widgets/label.slint";
import { Weather } from "state.slint";

// Now · next 8 hours · 5-day range bars.
export component WeatherPanel inherits Rectangle {
    border-width: Theme.hairline;
    border-color: Theme.line;
    border-radius: Theme.radius;

    if !Weather.has-data: VerticalLayout {
        alignment: center;
        spacing: 12px;
        Label { text: Weather.place == "" ? "WEATHER" : "WEATHER · " + Weather.place; color: Theme.text; horizontal-alignment: center; }
        Label { text: Weather.message; horizontal-alignment: center; }
    }

    if Weather.has-data: VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 12px;

        HorizontalLayout {
            Label { text: "WEATHER · " + Weather.place; color: Theme.text; }
            Rectangle { horizontal-stretch: 1; }
            Label { text: Weather.updated; }
        }

        // Now
        HorizontalLayout {
            spacing: 20px;
            Text {
                text: Weather.temp;
                font-family: Theme.mono;
                font-size: 84px;
                font-weight: 300;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: Weather.condition; font-family: Theme.mono; font-size: 18px; color: Theme.accent-text; letter-spacing: 1.5px; }
                Label { text: Weather.details; }
                Label { text: Weather.hilo; color: Theme.text; }
            }
        }

        // Next 8 hours
        Rectangle { height: Theme.hairline; background: Theme.line; }
        HorizontalLayout {
            for h in Weather.hours: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Label { text: h.hour; horizontal-alignment: center; }
                Text { text: h.temp; font-family: Theme.mono; font-size: 18px; color: Theme.text; horizontal-alignment: center; }
                Label { text: h.precip == "" ? " " : h.precip; color: Theme.accent-text; horizontal-alignment: center; }
            }
        }

        // Five days
        Rectangle { height: Theme.hairline; background: Theme.line; }
        VerticalLayout {
            spacing: 2px;
            for d in Weather.days: HorizontalLayout {
                height: 22px;
                spacing: 12px;
                Label { text: d.day; width: 56px; vertical-alignment: center; color: Theme.text; }
                Label { text: d.condition; width: 150px; vertical-alignment: center; overflow: elide; }
                Label { text: d.lo; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 2px;
                        background: Theme.line;
                    }
                    Rectangle {
                        x: parent.width * d.start;
                        width: max(6px, parent.width * (d.end - d.start));
                        y: (parent.height - self.height) / 2;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent-fill;
                    }
                }
                Label { text: d.hi; width: 40px; vertical-alignment: center; color: Theme.text; }
            }
        }
    }
}
