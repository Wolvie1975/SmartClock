import { Theme } from "../theme.slint";
import { Label } from "label.slint";
import { Marker } from "../state.slint";

// 24-hour day bar, 12 AM → 12 AM. `progress` is the fraction of the day elapsed (0..1).
// Markers: alarms (accent stripe + time caption), reminders (text dot), timer
// ends (muted dot), and calendar events (accent-text dot).
export component DayTimeline inherits Rectangle {
    in property <float> progress;
    in property <[Marker]> markers;
    height: 76 * Theme.u;

    property <[string]> ticks: ["12A", "3A", "6A", "9A", "12P", "3P", "6P", "9P", "12A"];
    property <length> caption-h: 20 * Theme.u;

    // Alarm captions: "7:00 AM" centered over the marker, clamped to the bar's ends.
    for m in root.markers: Text {
        visible: m.kind == 0;
        y: 0;
        height: root.caption-h - 4 * Theme.u;
        x: max(0px, min(root.width - self.width, root.width * m.pos - self.width / 2));
        text: m.label;
        font-family: Theme.mono;
        font-size: Theme.label;
        font-weight: 500;
        color: m.later ? Theme.muted : Theme.accent-text;
        vertical-alignment: center;
    }

    bar := Rectangle {
        y: root.caption-h;
        height: 20 * Theme.u;
        border-width: Theme.hairline;
        border-color: Theme.line;
        border-radius: Theme.radius;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * root.progress;
            background: Theme.panel;
        }
        for t[i] in root.ticks: Rectangle {
            x: parent.width * i / 8;
            width: Theme.hairline;
            background: Theme.line;
        }
        for m in root.markers: Rectangle {
            x: parent.width * m.pos - self.width / 2;
            width: m.kind == 0 ? 4 * Theme.u : 6 * Theme.u;
            height: m.kind == 0 ? parent.height : 6 * Theme.u;
            y: m.kind == 0 ? 0 : (parent.height - self.height) / 2;
            border-radius: m.kind == 0 ? 0 : 3 * Theme.u;
            background: m.kind == 0 ? (m.later ? Theme.muted : Theme.accent-fill)
                : m.kind == 1 ? Theme.text
                : m.kind == 3 ? Theme.accent-text : Theme.muted;
        }
        // now marker
        Rectangle {
            x: parent.width * root.progress - 1px;
            width: 2 * Theme.u;
            background: Theme.text;
        }
    }

    for t[i] in root.ticks: Label {
        y: bar.y + bar.height + 10 * Theme.u;
        x: i == 0 ? 0 : i == 8 ? root.width - self.width : root.width * i / 8 - self.width / 2;
        text: t;
    }
}
