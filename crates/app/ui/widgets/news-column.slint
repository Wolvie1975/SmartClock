import { Theme } from "../theme.slint";
import { Label } from "label.slint";
import { NewsItem } from "../state.slint";

component StoryCard inherits Rectangle {
    in property <NewsItem> item;
    callback open();

    height: 112 * Theme.u;

    VerticalLayout {
        spacing: 8 * Theme.u;
        HorizontalLayout {
            height: 24 * Theme.u;
            Label {
                text: root.item.source;
                color: Theme.accent-text;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Label {
                text: root.item.age;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.title;
            font-family: Theme.sans;
            font-size: 21 * Theme.u;
            color: ta.has-hover ? Theme.accent-text : Theme.text;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: 1;
            vertical-alignment: top;
        }
    }

    Rectangle {
        y: root.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.line;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.item.title;
        accessible-action-default => { root.open(); }
        clicked => { root.open(); }
    }
}

export component NewsColumn inherits VerticalLayout {
    in property <[NewsItem]> items;
    in property <string> footer;
    in property <bool> offline;
    callback open-story(string);

    padding-left: 24 * Theme.u;
    padding-right: 24 * Theme.u;
    spacing: 0;

    HorizontalLayout {
        height: Theme.touch;
        spacing: 12 * Theme.u;
        Label { text: "NEWS"; color: Theme.text; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Label {
            text: root.offline ? "OFFLINE" : "TOP 5";
            color: root.offline ? Theme.muted : Theme.accent-text;
            vertical-alignment: center;
        }
    }
    Rectangle { height: 12 * Theme.u; }
    Rectangle { height: Theme.hairline; background: Theme.line; }

    news-list := Flickable {
        vertical-stretch: 1;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: news-list.width;
            if root.items.length == 0: Label {
                text: root.offline ? "NO STORIES CACHED" : "LOADING STORIES…";
                height: 96 * Theme.u;
                vertical-alignment: center;
            }
            for item in root.items: StoryCard {
                item: item;
                open => { root.open-story(item.url); }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
    Label {
        text: root.footer;
        color: root.offline ? Theme.muted : Theme.accent-text;
        vertical-alignment: center;
        height: Theme.touch;
        overflow: elide;
    }
}
